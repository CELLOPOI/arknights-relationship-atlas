{
  "name": "arknights-relationship-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:atlas": "node --test --test-isolation=none src/atlas/data.test.mjs src/source-display.test.mjs",
    "test:game": "node --experimental-strip-types --test --test-isolation=none src/game/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "1.62.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
