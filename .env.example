# 生产示例；复制为 .env 后填写实际域名、随机密钥和密码，不提交 .env。
# 同一网站跨交付版本保持此名称；接管现有部署时填写其实际旧项目名。
COMPOSE_PROJECT_NAME=atlas
# DJANGO_SECRET_KEY 至少 50 字符；两项密钥可分别用 openssl rand -hex 32 生成。
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# SITE_ADDRESS 与 DJANGO_ALLOWED_HOSTS 填域名，不带协议。
SITE_ADDRESS=
DJANGO_ALLOWED_HOSTS=
# 下两项使用实际 https://域名；单站保持一致。
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_ORIGIN=
# 可选：API 在运行时提供 Cloudflare Web Analytics 站点标识；留空关闭。
# 修改后需重建 API 容器以读取新环境；普通 restart 不会重读 env_file。
# 这是网页公开的统计标识，不是管理 API 密钥；公共镜像构建时保持为空。
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Compose 强制首版社区关闭、正式资料受控发布。
FORMAL_DATA_MANAGED=1
COMMUNITY_ENABLED=0
REGISTRATION_ENABLED=0
# 修改网段时一并修改动态地址池和固定代理 IP；部署前核对无网络重叠。
# 固定代理 IP 在子网内、动态池外，避免先启动 API 占用代理地址。
ATLAS_PROXY_SUBNET=172.30.90.0/24
ATLAS_PROXY_DYNAMIC_RANGE=172.30.90.128/25
CADDY_PROXY_IP=172.30.90.2
# 可选 CDN 入口代理网段，空格分隔；留空为直连，不信任任何转发头。
# Cloudflare 代理使用其官方 IPv4/IPv6 网段，禁止填写全部公网或全部私网。
CADDY_TRUSTED_PROXY_CIDRS=
# Compose 将 FEEDBACK_TRUSTED_PROXY_IPS 设置为上述单个 CADDY_PROXY_IP。
# 非 Compose 部署应显式填写实际直连代理地址，不使用全部私网地址。
# FEEDBACK_TRUSTED_PROXY_IPS=
# 后台登录限流；无需为匿名反馈开放邮件或注册。
ADMIN_LOGIN_IP_LIMIT=30
ADMIN_LOGIN_ACCOUNT_LIMIT=8
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
